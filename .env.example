# Orbit configuration. Copy to .env and adjust for local development.
# Docker Compose reads this file automatically.

# --- Shared service settings -------------------------------------------------
ORBIT_KAFKA_BROKERS=redpanda:9092
ORBIT_KAFKA_TOPIC_PREFIX=orbit
ORBIT_LOG_LEVEL=info
ORBIT_LOG_FORMAT=text
ORBIT_ENV=development

# Enable per-order fault injection (development and tests only).
ORBIT_ENABLE_FAULT_INJECTION=true

# OTLP gRPC endpoint for traces. Leave empty to disable trace export.
ORBIT_OTLP_ENDPOINT=

# --- Outbox publisher --------------------------------------------------------
ORBIT_OUTBOX_POLL_INTERVAL=500ms
ORBIT_OUTBOX_BATCH_SIZE=100
ORBIT_OUTBOX_MAX_ATTEMPTS=12

# --- Consumers ---------------------------------------------------------------
ORBIT_CONSUMER_MAX_RETRIES=5
ORBIT_CONSUMER_RETRY_BACKOFF=250ms

# --- Per-service database URLs (one logical database per service) ------------
ORBIT_ORDER_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_order?sslmode=disable
ORBIT_INVENTORY_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_inventory?sslmode=disable
ORBIT_PAYMENT_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_payment?sslmode=disable
ORBIT_FULFILLMENT_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_fulfillment?sslmode=disable
ORBIT_NOTIFICATION_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_notification?sslmode=disable

# Single database URL used by the orbitctl CLI and by the integration tests.
ORBIT_DATABASE_URL=postgres://orbit:orbit@postgres:5432/orbit_order?sslmode=disable
